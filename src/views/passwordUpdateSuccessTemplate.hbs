<div style="max-width: 600px; margin: 40px auto; background-color: #ffffff; padding: 30px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05); text-align: center;">

    <img src="https://img.icons8.com/fluency/96/password-window.png" alt="Password Updated" style="width: 80px; height: 80px; margin-bottom: 20px;" />

    <h2 style="color: #333333; margin-bottom: 10px;">Your Password Has Been Updated</h2>

    <p style="font-size: 16px; color: #555555;">
      Hi {{userName}},<br />
      This is a confirmation that your password was successfully updated for your {{companyName}} account.
    </p>

    <p style="font-size: 14px; color: #888888; margin-top: 20px;">
      If you did not perform this change, please reset your password immediately and contact our support team.
    </p>

    <a href="{{link}}" target="_blank" style="display: inline-block; margin-top: 25px; padding: 12px 25px; background-color: #007bff; color: #ffffff; text-decoration: none; border-radius: 5px; font-weight: bold;">
      Contact Support
    </a>

    <p style="font-size: 14px; color: #888888; margin-top: 30px;">
      — The {{companyName}} Team
    </p>

  </div>
