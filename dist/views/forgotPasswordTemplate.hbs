<div style="margin: 0; padding: 0; font-family: Arial, sans-serif; background-color: #f4f4f4;">

  <div style="max-width: 600px; margin: 40px auto; background-color: #ffffff; padding: 30px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05); text-align: center;">

    <img src="https://res.cloudinary.com/dtxai4k4r/image/upload/v1747605668/mailPic_qp8d51.png" alt="Email Icon" />

    <h2 style="color: #333333; margin-bottom: 10px;">Email Verification Code</h2>

    <p style="font-size: 16px; color: #555555;">
      Hello {{userName}},<br />
      Use the verification code below to complete your sign-up or secure your account.
    </p>

    <div style="margin: 30px auto; background-color: #f1f1f1; display: inline-block; padding: 15px 30px; border-radius: 6px; font-size: 28px; font-weight: bold; color: #222;">
      {{verificationCode}}
    </div>

    <p style="font-size: 14px; color: #888888; margin-top: 20px;">
      This code will expire in 10 minutes. If you didn’t request this, you can safely ignore this email.
    </p>

    <p style="font-size: 14px; color: #888888;">
      — The {{companyName}} Team
    </p>

  </div>

</div>
